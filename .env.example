# Existing website
SECRET_KEY=replace-with-a-long-random-secret
EMAIL_USER=loyaltyhomes.or@gmail.com
EMAIL_PASS=replace-with-an-app-password

# Set to 1 on the HTTPS production site; use 0 for local HTTP testing.
SESSION_COOKIE_SECURE=1

# Company calendar branding
COMPANY_NAME=Loyalty Group Homes
COMPANY_ADDRESS=12640 SE Madison St, Portland, Oregon 97233
COMPANY_TIMEZONE=America/Los_Angeles

# Manager scheduling center
CALENDAR_ADMIN_USERNAME=manager
# Prefer a Werkzeug password hash in production.
CALENDAR_ADMIN_PASSWORD_HASH=
# Temporary fallback; do not commit a real password.
CALENDAR_ADMIN_PASSWORD=
CALENDAR_ADMIN_IDLE_MINUTES=5

# Read-only office display
CALENDAR_DISPLAY_PIN=

# local or google
CALENDAR_BACKEND=local
CALENDAR_DB_PATH=appointments.db

# Google Calendar (required when CALENDAR_BACKEND=google)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
